{
  "manifest_version": 3,
  "name": "Molt Agent",
  "version": "0.1.0",
  "description": "AI-native learning layer. Works on any LMS.",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.net/*",
        "https://*.blackboard.com/*",
        "https://*.brightspace.com/*",
        "https://*.desire2learn.com/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Molt Agent"
  },

  "icons": {
    "16": "icons/molt-16.png",
    "48": "icons/molt-48.png",
    "128": "icons/molt-128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
