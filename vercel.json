{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/course-architect.ts": { "maxDuration": 60 },
    "api/agentic-grader.ts": { "maxDuration": 60 },
    "api/expand-announcements.ts": { "maxDuration": 60 },
    "api/discuss.ts": { "maxDuration": 30 }
  }
}
